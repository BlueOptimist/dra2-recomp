// DRA 2.exe's icon and version information (tools/launcher/build.ps1)
#include <winver.h>

1 ICON "icon.ico"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Digimon Rumble Arena 2 - Windows port launcher"
      VALUE "ProductName", "dra2-recomp"
      VALUE "OriginalFilename", "DRA 2.exe"
      VALUE "FileVersion", "1.0"
      VALUE "ProductVersion", "1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

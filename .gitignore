# Whitelist. This repository holds only our own work: tools, the Windows platform layer, headers we wrote, notes
# and the hand-made naming tables. Everything from the game stays local: the disc image, extracted/unpacked
# assets, the Ghidra project, the decompiled code (decomp/src, decomp/lib), generated build files and data dumps.
# To add a file, add a "!" line for it below; never un-ignore a whole directory.

/*
!/.gitignore
!/.gitattributes
!/README.md
!/.github/

# vendored open-source code, unmodified, with its license (Lua 5.0.3: MIT, see third_party/lua-5.0.3/COPYRIGHT)
!/third_party/

!/tools/
/tools/__pycache__/

!/decomp/
/decomp/*
!/decomp/README.md
!/decomp/ghidra_types.h
!/decomp/dra2_formats.h
!/decomp/input_actions.h
!/decomp/port/
/decomp/port/*
!/decomp/port/platform.c
!/decomp/port/cxx_runtime.c
!/decomp/port/xapi.c
!/decomp/port/crt_math.c
!/decomp/port/startup.c
!/decomp/port/crash.c
!/decomp/port/d3d8.c
!/decomp/port/gpu.c
!/decomp/port/nv2a.c
!/decomp/port/nv2a.h
!/decomp/port/pushbuffer.c
!/decomp/port/calls.c
!/decomp/port/game_fixes.c
!/decomp/port/win32_min.h

!/analysis/
/analysis/*
!/analysis/modules.tsv
!/analysis/classes.tsv
!/analysis/class_names.tsv
!/analysis/function_names.tsv
!/analysis/slot_names.tsv
!/analysis/field_names.tsv
!/analysis/crt_signatures.tsv
!/analysis/lua_signatures.tsv
!/analysis/startup_signatures.tsv
!/analysis/lost_returns.tsv
!/analysis/ecx_this.tsv
!/analysis/register_params.tsv
!/analysis/varargs.tsv
!/analysis/call_overrides.tsv
!/analysis/fixed_signatures.tsv
!/analysis/false_register_params.tsv
!/analysis/purge_mismatches.tsv
!/analysis/indirect_pops.tsv
!/analysis/fp_conversions.tsv
!/analysis/format_calls.tsv
!/analysis/stack_params.tsv
!/analysis/narrow_params.tsv
!/analysis/missing_this.tsv
!/analysis/code_pops.tsv
!/analysis/source_patches.tsv
